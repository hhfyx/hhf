# 本地开发配置模板：复制成 .env 再改值；真实密钥永远不要提交
#   cp .env.example .env

# 运行环境：dev / staging / prod（prod 下 API_KEY 必须 >= 16 位且不能 sk-test 开头）
APP_ENV=dev
# 日志级别：DEBUG / INFO / WARNING / ERROR（大小写不敏感，会规整成大写）
LOG_LEVEL=INFO
# 是否打印 SQL，仅 dev 建议开
LOG_SQL=false

# 必填：第三方 / 大模型 API key
API_KEY=sk-local-dev-0123456789

# 业务参数
REQUEST_TIMEOUT=30
MAX_DOC_CHARS=8000
EXTRACT_MODEL=extract-v1
